# Required
GEMINI_API_KEY=your_gemini_api_key_here        # aistudio.google.com (free, no credit card)
SERPER_API_KEY=your_serper_api_key_here        # serper.dev (2500 free queries/month)

# Optional - Reddit (for better trend data; app-only auth, no user login needed)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ViralContentAI/1.0

# Optional - paths
CHROMA_PERSIST_DIR=./memory/performance_db
OUTPUTS_DIR=./outputs
